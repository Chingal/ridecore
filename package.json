{
  "name": "ridecore",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "token": "node --import ./scripts/load-env.ts scripts/dev-token.ts",
    "build": "node scripts/build.ts",
    "dev": "node --import ./scripts/load-env.ts src/local/server.ts",
    "seed": "node --import ./scripts/load-env.ts scripts/seed.ts",
    "package": "npm run build && eval \"$(node scripts/load-env.ts --print)\" && serverless package",
    "mcp": "node --import ./scripts/load-env.ts src/mcp/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^24.19.2",
    "aws-cdk": "^2.1148.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "osls": "^4.6.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1166.0",
    "@aws-sdk/client-dynamodb": "^3.1165.0",
    "@aws-sdk/client-eventbridge": "^3.1166.0",
    "@aws-sdk/client-sns": "^3.1166.0",
    "@aws-sdk/client-sqs": "^3.1166.0",
    "@aws-sdk/lib-dynamodb": "^3.1165.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "jose": "^6.2.17",
    "ngeohash": "^0.6.3",
    "zod": "^4.6.7"
  }
}
